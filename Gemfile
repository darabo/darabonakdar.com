source "https://rubygems.org"

# Matches the exact Jekyll environment GitHub Pages uses to build the site,
# so local previews behave the same as production.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Needed for `jekyll serve` on Ruby 3+
gem "webrick"
